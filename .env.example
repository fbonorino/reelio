DATABASE_URL="file:./dev.db"

# Cloudinary (server-side, used only for delete operations from /host)
CLOUDINARY_CLOUD_NAME=""
CLOUDINARY_API_KEY=""
CLOUDINARY_API_SECRET=""

# Cloudinary (client-side, used for direct unsigned uploads from the browser)
NEXT_PUBLIC_CLOUDINARY_CLOUD_NAME=""
NEXT_PUBLIC_CLOUDINARY_UPLOAD_PRESET=""

# Event config
NEXT_PUBLIC_EVENT_NAME="Our Party"
HOST_SECRET="change-me"
# When the game ends (ISO date WITH timezone offset). Drives the countdown and
# closes the game afterwards: the ranking freezes, and new uploads are keepsakes
# worth no points. Leave empty for no countdown.
NEXT_PUBLIC_EVENT_END_TIME="2026-09-28T04:00:00-03:00"
