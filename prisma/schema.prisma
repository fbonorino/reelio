generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum MediaType {
  IMAGE
  VIDEO
}

model Photo {
  id              String    @id @default(cuid())
  url             String
  thumbnailUrl    String
  type            MediaType
  /// Normalized Instagram handle (lowercase, no "@") of the uploader.
  instagram       String
  /// A Challenge id, or "libre" for a free photo (FREE_PHOTO in src/lib/challenges.ts).
  challengeId     String
  /// Points snapshot at upload time, so editing the list later doesn't rewrite history.
  challengePoints Int
  /// Set by the host when the photo doesn't meet its challenge: its challenge points stop counting.
  invalidated     Boolean   @default(false)
  /// Last time the host invalidated or restored it. Breaks ranking ties: whoever reached their score first wins.
  adjustedAt      DateTime?
  /// Uploaded after NEXT_PUBLIC_EVENT_END_TIME: a keepsake only. challengePoints is 0 and it's left out of the ranking.
  postDeadline    Boolean   @default(false)
  /// Uploaded for a bonus track challenge: challengePoints already has the multiplier applied, and it
  /// counts against the bonus quota (BONUS_EXTRA_PHOTOS) instead of MAX_PHOTOS_PER_USER.
  isBonus         Boolean   @default(false)
  likeCount       Int       @default(0)
  createdAt       DateTime  @default(now())
  likes           Like[]

  @@index([likeCount])
  @@index([createdAt])
  @@index([instagram])
}

/// The game's challenges, managed from /host.
model Challenge {
  id        String   @id @default(cuid())
  label     String
  points    Int
  /// Order guests see them in, lowest first.
  position  Int
  /// Removed from the game: can't be picked any more, but kept so photos that used it still show its label.
  retired   Boolean  @default(false)
  /// Bonus track challenge: secret until the bonus window opens, only pickable while it's open, and
  /// worth `points` (the base the host typed) times BONUS_MULTIPLIER. Ordered separately from the rest.
  isBonus   Boolean  @default(false)
  createdAt DateTime @default(now())

  @@index([isBonus, retired, position])
}

enum BonusOverride {
  /// The window opens and closes on its own at bonusStartsAt / bonusEndsAt.
  AUTO
  OPEN
  CLOSED
}

/// Event-wide settings changed from /host. A single row (id 1); until it exists, the defaults in src/lib/bonus.ts apply.
model EventSettings {
  id              Int           @id @default(1)
  /// Bonus track window, in UTC. The end is capped at NEXT_PUBLIC_EVENT_END_TIME when it's read.
  bonusStartsAt   DateTime
  bonusEndsAt     DateTime
  bonusOverride   BonusOverride @default(AUTO)
  /// When bonusOverride last changed: a forced close starts the upload grace period from here.
  bonusOverrideAt DateTime?
  /// First time the host forced the window open. Only matters while forced closed: closing it after a
  /// forced open keeps the challenges visible (disabled). Back on AUTO, only the clock counts.
  bonusRevealedAt DateTime?
  updatedAt       DateTime      @updatedAt
}

model Like {
  id        String   @id @default(cuid())
  photoId   String
  /// Normalized Instagram handle (lowercase, no "@") of whoever gave the like.
  instagram String
  createdAt DateTime @default(now())

  photo Photo @relation(fields: [photoId], references: [id], onDelete: Cascade)

  /// One like per handle per photo, enforced by the DB so concurrent requests can't double-count.
  @@unique([photoId, instagram])
  @@index([photoId])
  @@index([instagram])
}

/// Guest list: only these handles can upload photos and give likes. Managed from /host.
model AllowedHandle {
  id        String   @id @default(cuid())
  /// Normalized Instagram handle (lowercase, no "@"), same format as Photo.instagram.
  handle    String   @unique
  createdAt DateTime @default(now())
}

enum AccessRequestStatus {
  PENDING
  APPROVED
  REJECTED
}

/// A guest who couldn't find their handle on the list and asked to be added. Approving it adds the
/// handle to AllowedHandle; the guest's waiting screen notices and lets them in.
model AccessRequest {
  id        String              @id @default(cuid())
  /// Normalized Instagram handle (lowercase, no "@"), same format as AllowedHandle.handle. One request per handle.
  handle    String              @unique
  status    AccessRequestStatus @default(PENDING)
  createdAt DateTime            @default(now())
  decidedAt DateTime?

  @@index([status, createdAt])
}
