generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum MediaType {
  IMAGE
  VIDEO
}

model Photo {
  id              String    @id @default(cuid())
  url             String
  thumbnailUrl    String
  type            MediaType
  /// Normalized Instagram handle (lowercase, no "@") of the uploader.
  instagram       String
  /// Challenge id from src/lib/challenges.ts.
  challengeId     String
  /// Points snapshot at upload time, so editing the list later doesn't rewrite history.
  challengePoints Int
  /// Set by the host when the photo doesn't meet its challenge: its challenge points stop counting.
  invalidated     Boolean   @default(false)
  likeCount       Int       @default(0)
  createdAt       DateTime  @default(now())
  likes           Like[]

  @@index([likeCount])
  @@index([createdAt])
  @@index([instagram])
}

model Like {
  id        String   @id @default(cuid())
  photoId   String
  deviceId  String
  createdAt DateTime @default(now())

  photo Photo @relation(fields: [photoId], references: [id], onDelete: Cascade)

  @@unique([photoId, deviceId])
  @@index([photoId])
}
